# 游戏服务端镜像：pnpm 工作区安装 → 构建依赖包 → tsx 运行 server
# （内部测试版：tsx 运行省去 server 自身编译；生产化再切 dist。）
FROM node:22-alpine
WORKDIR /app

RUN corepack enable

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/content/package.json packages/content/
COPY packages/game-rules/package.json packages/game-rules/
COPY packages/ai-prompts/package.json packages/ai-prompts/
COPY apps/server/package.json apps/server/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/server ./apps/server
COPY apps/server/drizzle ./apps/server/drizzle

EXPOSE 3000

# 迁移先行（drizzle-kit 走 drizzle.config.ts 读 DATABASE_URL），然后启动。
CMD ["sh", "-c", "pnpm --filter @ai-mud/shared build && pnpm --filter @ai-mud/content build && pnpm --filter @ai-mud/game-rules build && pnpm --filter @ai-mud/ai-prompts build && pnpm --filter @ai-mud/server db:migrate && cd apps/server && node --import tsx src/main.ts"]
