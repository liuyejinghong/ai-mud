NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
WEB_PORT=5173
WEB_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=postgres://ai_mud:ai_mud_dev_password@127.0.0.1:55432/ai_mud
SESSION_COOKIE_NAME=ai_mud_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-use
WORLD_TICK_ENABLED=true
# 开发试玩：允许无激活码注册并直达基地（正式部署必须显式设 true，默认关闭）
PLAYTEST_REGISTRATION_ENABLED=true
WORLD_TICK_INTERVAL_MS=60000
WORLD_TICK_MAX_STEPS=60
AI_NPC_DIALOGUE_ENABLED=false
AI_PROVIDER=template
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_DIALOGUE_TIMEOUT_MS=8000
AI_DIALOGUE_MAX_OUTPUT_TOKENS=400

# Jev 对照（M14 seam）：shadow=真 Jev 只做对照记录不改变调度；off=纯规则
# TYPE_SAFE_DECISION_MODE=shadow
# TYPE_SAFE_API_KEY=（OpenRouter key，或复用 ~/tools/jev-ultrafast/.env）
# TYPE_SAFE_MODEL=jev-latest
