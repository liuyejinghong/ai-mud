NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
WEB_PORT=5173
WEB_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ai_mud
SESSION_COOKIE_NAME=ai_mud_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-use
WORLD_TICK_ENABLED=true
WORLD_TICK_INTERVAL_MS=60000
WORLD_TICK_MAX_STEPS=60
AI_NPC_DIALOGUE_ENABLED=false
AI_PROVIDER=template
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_DIALOGUE_TIMEOUT_MS=8000
AI_DIALOGUE_MAX_OUTPUT_TOKENS=400
