{
  "name": "@ai-mud/content",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @ai-mud/shared build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "pnpm --filter @ai-mud/shared build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-mud/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
